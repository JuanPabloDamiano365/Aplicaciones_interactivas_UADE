<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom.xml
    =======
    Archivo de configuración de Maven. Acá se define:
      - De qué "parent" hereda el proyecto (spring-boot-starter-parent), que ya trae
        versiones compatibles de todas las librerías de Spring.
      - Los datos del proyecto (groupId, artifactId, version).
      - Las dependencias (librerías) que vamos a usar.
      - El plugin que empaqueta la app como un .jar ejecutable.

    NOTA IMPORTANTE sobre el pom.xml original subido:
    Tenía artifactIds que no existen en Maven Central
    ("spring-boot-starter-webmvc", "spring-boot-h2console"), lo que hacía que el
    proyecto NO pudiera descargar dependencias y no compilara. Acá se usan los
    artifactIds reales y una versión estable de Spring Boot (3.3.4) para que el
    proyecto compile y corra sin tocar nada más.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Proyecto "padre" de Spring Boot: fija versiones compatibles entre sí -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- se busca en el repositorio remoto, no en el disco -->
	</parent>

	<!-- Identificación del proyecto (Group/Artifact/Version -> coordenadas Maven) -->
	<groupId>com.uade</groupId>
	<artifactId>tppresencial_1</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>tppresencial_1</name>
	<description>TPO - E-commerce de zapatillas - Spring Boot + Spring Data JPA</description>

	<properties>
		<!-- Versión de Java que se usa para compilar y correr el proyecto -->
		<java.version>25</java.version>
		<lombok.version>1.18.48</lombok.version>
	</properties>

	<dependencies>
		<!-- Habilita Spring Web MVC: @RestController, @RequestMapping, servidor Tomcat embebido, etc. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Habilita Spring Data JPA: repositorios, Hibernate como implementación de JPA -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Validaciones de Bean Validation (@NotNull, @NotBlank, etc.) sobre los DTOs -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
		    Base de datos H2: motor de base de datos relacional 100% en memoria.
		    Se usa como base de datos por defecto para que el proyecto "ande" apenas
		    se descomprime, sin necesidad de instalar MySQL. Los datos se guardan en
		    un archivo local (no se pierden al reiniciar) gracias a la config del
		    application.properties.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    Driver de MySQL: queda disponible como dependencia por si se quiere
		    apuntar el proyecto a una base de datos MySQL real (ver
		    application.properties, sección "Perfil MySQL").
		-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    Lombok: genera automáticamente (en tiempo de compilación) los getters,
		    setters, constructores, equals/hashCode, toString, etc. a partir de
		    anotaciones como @Data, @Getter, @Setter, @Builder. Evita escribir
		    código repetitivo ("boilerplate") a mano.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Dependencias necesarias solo para correr los tests (JUnit, Mockito, etc.) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Plugin que arma el .jar ejecutable ("fat jar") y permite correr con mvn spring-boot:run -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Excluye a Lombok del jar final: solo hace falta en tiempo de compilación -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
